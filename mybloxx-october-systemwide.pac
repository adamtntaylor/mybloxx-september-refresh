function suffixMatch(table, host) {
  host=(host||"").toLowerCase().replace(/\.$/,"");
  if (table[host]) return true;
  var p=host.indexOf(".");
  while (p>0) {
    host=host.substring(p+1);
    if (table[host]) return true;
    p=host.indexOf(".");
  }
  return false;
}

function localHost(host) {
  if (isPlainHostName(host)) return true;
  if (shExpMatch(host,"*.local") || shExpMatch(host,"*.lan") || shExpMatch(host,"*.home.arpa")) return true;
  if (shExpMatch(host,"127.*") || shExpMatch(host,"10.*") || shExpMatch(host,"192.168.*")) return true;
  if (shExpMatch(host,"172.16.*") || shExpMatch(host,"172.17.*") || shExpMatch(host,"172.18.*") ||
      shExpMatch(host,"172.19.*") || shExpMatch(host,"172.2?.*") || shExpMatch(host,"172.30.*") ||
      shExpMatch(host,"172.31.*")) return true;
  return false;
}

function FindProxyForURL(url, host) {
  host=(host||"").toLowerCase().replace(/\.$/,"");
  if (localHost(host)) return DIRECT;
  if (suffixMatch(ALLOW,host)) return DIRECT;
  if (suffixMatch(BLOCK,host)) return BLOCKED;
  return DIRECT;
}
